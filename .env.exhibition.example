# Server-only. Never prefix these with NEXT_PUBLIC_. No values are included here.
EXHIBITION_SUPABASE_URL=
EXHIBITION_SUPABASE_SERVICE_ROLE_KEY=
# Generate a unique random secret >=32 characters; keep stable for idempotent ticket recovery.
EXHIBITION_BOOKING_SECRET=
# Exact browser origin, e.g. production URL without trailing slash.
BOOKING_ORIGIN=
# Existing NEXT_PUBLIC_EMAILJS_* values remain for ordinary bookings.
# Configure server EmailJS access and approved origin before activation.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
